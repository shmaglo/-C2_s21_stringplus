#test strtokTest_1
char str1[50] = "   When I was young and cheerful";
char delim1[10] = " ";
char str2[50] = "   When I was young and cheerful";
char delim2[10] = " ";
char *token_1;
char *token_2;
token_1 = strtok(str1, delim1);
token_2 = s21_strtok(str2, delim2);
if (token_1 == s21_NULL) {
    ck_assert_ptr_eq(token_1, token_2);
} else {
    ck_assert_str_eq(token_1, token_2);
    while (token_1 != s21_NULL) {
        token_1 = strtok(s21_NULL, delim1);
        token_2 = s21_strtok(s21_NULL, delim2);
        if (token_1 == s21_NULL) {
            ck_assert_ptr_eq(token_1, token_2);
        } else {
            ck_assert_str_eq(token_1, token_2);
        }
    }
}

