ck_assert_ptr_eq(memchr(str1, ' ', 6), s21_memchr(str1, ' ', 6));

#test memcmpTest_1
char str1[7] = "A";
char str2[7] = "a";
int result_1 = 0;
int result_2 = 0;
if (memcmp(str1, str2, 6) < 0) result_1 = -1;
if (memcmp(str1, str2, 6) > 0) result_1 = 1;
if (s21_memcmp(str1, str2, 6) < 0) result_2 = -1;
if (s21_memcmp(str1, str2, 6) > 0) result_2 = 1;
ck_assert_int_eq(result_1, result_2);

#test memcmpTest_2
char str1[5] = "AAA";
char str2[5] = "aaa";
ck_assert_int_eq(memcmp(str1, str2, 0), s21_memcmp(str1, str2, 0));

#test memcmpTest_3
char str1[5] = "\0";
char str2[5] = "";
ck_assert_int_eq(memcmp(str1, str2, 2), s21_memcmp(str1, str2, 2));

#test memcmpTest_4
char str1[10] = "Hellooo";
char str2[10] = "Hello";
ck_assert_int_eq(memcmp(str1, str2, 3), s21_memcmp(str1, str2, 3));

#test memcmpTest_5
