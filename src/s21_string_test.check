#include <limits.h>
#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <math.h>
#include <stdarg.h>
#include <float.h>
#include "s21_string.h"

#test strlenTest
ck_assert_int_eq(strlen("Hello"), s21_strlen("hello"));
ck_assert_int_eq(strlen("\0"), s21_strlen("\0"));
ck_assert_int_eq(strlen("\n"), s21_strlen("\n"));

#test strlenTest_1
char str1[20] = "Hello, my friend";
char str2[20] = "Hello, my love!!";
ck_assert_int_eq(strlen(str1), s21_strlen(str2));

#test strlenTest_2
char str1[5] = "\0";
ck_assert_int_eq(strlen(str1), s21_strlen(str1));

#test strlenTest_3
char str1[5] = "\n";
ck_assert_int_eq(strlen(str1), s21_strlen(str1));

#test strlenTest_4
char str1[5] = "";
ck_assert_int_eq(strlen(str1), s21_strlen(str1));

#test strcspnTest_1
char str1[10] = "123456789";
char str2[10] = "9876";
ck_assert_int_eq(strcspn(str1, str2), s21_strcspn(str1, str2));

#test strcspnTest_2
char str1[15] = "hello\0bye";
char str2[15] = "\0";
ck_assert_int_eq(strcspn(str1, str2), s21_strcspn(str1, str2));

#test strcspnTest_3
char str1[10] = "\0";
char str2[10] = "hello\0";
ck_assert_int_eq(strcspn(str1, str2), s21_strcspn(str1, str2));

#test strcspnTest_4
char str1[10] = "holi\nday";
char str2[10] = "a";
ck_assert_int_eq(strcspn(str1, str2), s21_strcspn(str1, str2));

#test strcspnTest_5
char str1[5] = "\1";
char str2[5] = "\n";
ck_assert_int_eq(strcspn(str1, str2), s21_strcspn(str1, str2));

#test strpbrkTest_1
char str1[5] = "Love";
char str2[5] = "l";
ck_assert_ptr_eq(strpbrk(str1, str2), s21_strpbrk(str1, str2));

#test strpbrkTest_2
char str1[10] = "PLEASe";
char str2[10] = "please";
ck_assert_ptr_eq(strpbrk(str1, str2), s21_strpbrk(str1, str2));

#test strpbrkTest_3
char str1[10] = "123456789";
char str2[10] = "9876";
ck_assert_ptr_eq(strpbrk(str1, str2), s21_strpbrk(str1, str2));

#test strpbrkTest_4
char str1[10] = "123\0bye";
char str2[10] = "bye\0";
ck_assert_ptr_eq(strpbrk(str1, str2), s21_strpbrk(str1, str2));

#test strpbrkTest_5
char str1[5] = "";
char str2[5] = "";
ck_assert_ptr_eq(strpbrk(str1, str2), s21_strpbrk(str1, str2));

#test strpbrkTest_6
char str1[10] = "Please";
char str2[10] = "a";
ck_assert_ptr_eq(strpbrk(str1, str2), s21_strpbrk(str1, str2));

#test strerrorTest_1
for (int i = -1000; i < 1000; i++) {
    ck_assert_str_eq(strerror(i), s21_strerror(i));
}

#test memchrTest_1 
char str1[25] = "Hello, my name is Jenny";
ck_assert_ptr_eq(memchr(str1, '\0', 6), s21_memchr(str1, '\0', 6));

#test memchrTest_2
char str1[25] = "Hello, my name is Jenny";
ck_assert_ptr_eq(memchr(str1, 'l', 6), s21_memchr(str1, 'l', 6));

#test memchrTest_3
char str1[10] = "Hello";
ck_assert_ptr_eq(memchr(str1, '\0', 6), s21_memchr(str1, '\0', 6));

#test memchrTest_4
