#test sprintf_1
char str1[1024] = "";
char str2[1024] = "";
char format[50] = "%.d";
int value = -60;

sprintf(str1, format, value);
s21_sprintf(str2, format, value);
ck_assert_int_eq(strcmp(str1, str2), 0);
ck_assert_str_eq(str1, str2);

#test sprintf_3
char str1[1024] = "";
char str2[1024] = "";
int res1;
int res2;
char format[50] = "%.d";
int value = 0;

res1 = sprintf(str1, format, value);
res2 = s21_sprintf(str2, format, value);
ck_assert_int_eq(res1, res2);
ck_assert_str_eq(str1, str2);

#test sprintf_4
char str1[1024] = "";
char str2[1024] = "";
char format[50] = "%.d";
int value = 9;

sprintf(str1, format, value);
s21_sprintf(str2, format, value);
ck_assert_int_eq(strcmp(str1, str2), 0);
ck_assert_str_eq(str1, str2);

#test sprintf_5
char str1[1024] = "";
char str2[1024] = "";
char format[50] = "%.d";
int value = +1;

sprintf(str1, format, value);
s21_sprintf(str2, format, value);
