#test to_lower_Test_1
char str1[50] = "HELLO, worlD, 123456!";
char *str2 = s21_to_lower(str1);
ck_assert_str_eq("hello, world, 123456!", str2);
free(str2);

#test to_lower_Test_2
char str1[50] = "HOW are YOU???";
char *str2 = s21_to_lower(str1);
ck_assert_str_eq("how are you???", str2);
free(str2);

#test to_upper_Test_1
char str1[1024] = "asd";
char *str2 = s21_to_upper(str1);
ck_assert_str_eq(str2, "ASD");
free(str2);

#test to_upper_Test_2
char str1[1024] = "asdBGT !!!";
char *str2 = s21_to_upper(str1);
ck_assert_str_eq(str2, "ASDBGT !!!");
free(str2);
